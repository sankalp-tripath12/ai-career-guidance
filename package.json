{
  "name": "ai-career-guidance(desktop)",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -k \"npm run dev --prefix frontend\" \"wait-on http://localhost:5173 && ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "build:frontend": "npm run build --prefix frontend",
    "start:desktop": "electron .",
    "pack:mac": "npm run build:frontend && electron-builder --mac dir",
    "dist:mac": "npm run build:frontend && electron-builder --mac dmg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sankalp-tripath12/ai-career-guidance.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sankalp-tripath12/ai-career-guidance/issues"
  },
  "homepage": "https://github.com/sankalp-tripath12/ai-career-guidance#readme",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.pathpilot.desktop",
    "productName": "PathPilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/**/node_modules/**",
          "!node_modules/nodemon/**",
          "!node_modules/.bin/**",
          "!.env",
          "!.env.*",
          "!**/.env",
          "!**/.env.*"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!nodemon/**",
          "!**/nodemon/**",
          "!.bin/**",
          "!**/.bin/**"
        ]
      }
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.education"
    }
  }
}
